# Simplified Dockerfile for sigul bridge using dedicated build scripts
# Base image pinned by digest for supply-chain integrity (Scorecard
# Pinned-Dependencies). Dependabot maintains the digest via the docker
# ecosystem entry in .github/dependabot.yml.
FROM fedora:44@sha256:43b29f65a41eb9c35e1cd5323e3bdf3b655c2357a9f4f1ff2f9c2798e5045d80

LABEL maintainer="releng@linuxfoundation.org"
# Standard OCI metadata labels (image.title, image.description,
# image.source, image.url, image.revision, image.created,
# image.licenses, image.version) are generated by
# docker/metadata-action in the CI workflow at build time. See
# .github/workflows/{build-test,release}.yaml for the values used.

# Update package manager
RUN dnf update -y && \
    dnf clean all

# Install base dependencies available in Fedora repositories
RUN dnf update -y && \
    dnf install -y --setopt=install_weak_deps=False \
        git which tar xz patch \
        python3-devel python3-pip python3-setuptools python3-cryptography \
        python3-requests python3-six python3-pexpect \
        sqlite \
        nss-tools nmap-ncat \
        hostname iproute net-tools \
        make gcc autoconf automake libtool \
        procps-ng util-linux bind-utils \
        strace lsof \
        vim-minimal less findutils grep \
        wget rsync sudo && \
    dnf clean all

# Every pip install below reads a hash lock from
# build-scripts/requirements. uv compiles each lock from the .in
# beside it, Dependabot bumps the locks, and pip runs with
# --require-hashes, so a build proceeds only with artefacts whose
# sha256 matches the lock. The copy goes once the last install has run.
#
# --require-hashes stops at the packages it installs: a source build
# would pull its build backend into an isolated environment that the
# lock does not reach. Each install therefore either takes wheels only
# (--only-binary) or, where a package has no wheel for this Python,
# builds with --no-build-isolation against the locked setuptools.
COPY build-scripts/requirements/ /tmp/requirements/

# Patch CVEs that fedora:44 ships unpatched in its Python packages.
# advisories.in lists each advisory and its first fixed release; the
# lock resolves those floors to the newest release at compile time.
# Upgrading via pip is required because Fedora 44 has not (yet) pushed
# fixed builds of every package listed, so 'dnf upgrade' alone leaves
# the flagged versions in place. --break-system-packages overrides
# Fedora's EXTERNALLY-MANAGED marker (PEP 668) so the upgraded versions
# land under /usr/local, ahead of the dnf tree. The upgraded pip
# protects the installs below; pip itself is removed once they finish
# (build-scripts/remove-pip.sh), because no pip release fixes the
# urllib3 it vendors.
#
# setuptools >= 82 no longer bundles pkg_resources. The dnf-managed
# copy under /usr/lib stays on sys.path and still satisfies
# 'import pkg_resources' for any consumer that needs it.
#
# The loop then drops the superseded dist-info from the dnf tree for
# every package pip placed under /usr/local, the lock's transitive
# dependencies included, so the Grype SBOM scan reports only the
# version that is imported; leaving both would make Grype flag the old
# metadata as a second, vulnerable install. Iterating over what pip
# installed also covers a dnf-provided version that already matches
# the lock: pip then installs nothing, there is no replacement to
# point at, and the dnf metadata stays, or the package would disappear
# from the SBOM altogether. pip is skipped: remove-pip.sh deletes the
# dnf package outright, and dnf needs that metadata intact to remove
# it cleanly.
#
# The lock pins exact versions, so a dnf update that overtook the lock
# would be shadowed by the older locked release until Dependabot's
# next bump; the Grype gate catches that where it carries an advisory.
#
# The lib* globs matter: pure-Python packages (setuptools) live
# under lib/, but packages with compiled extensions (cryptography)
# land in Fedora's platform-specific lib64/ tree - in both the dnf
# and /usr/local install roots. Checking only lib/ leaves the stale
# dnf dist-info behind and Grype keeps flagging the old version.
RUN python3 -m pip install --require-hashes --only-binary=:all: \
        --break-system-packages -r /tmp/requirements/advisories.txt && \
    for info in /usr/local/lib*/python3*/site-packages/*.dist-info; do \
        [ -d "$info" ] || continue; \
        name="${info##*/}"; name="${name%%-*}"; \
        case "$name" in pip) continue ;; esac; \
        rm -rf /usr/lib*/python3*/site-packages/"${name}"-*.dist-info; \
    done

# Install EPEL-dependent packages and Python packages via pip
# Note: nss-devel and nspr-devel removed - python-nss-ng installed from PyPI (pre-built)
# Note: Python 3.13/3.14 removed the crypt module - install passlib for compatibility;
#       build-scripts/requirements/sigul.in explains the SQLAlchemy and passlib pins.
# Note: SQLAlchemy 1.3.24 predates Python 3.14 wheels and builds from its
#       sdist; --no-build-isolation makes that build use the hash-locked
#       setuptools installed above rather than one pip would fetch,
#       unverified, into an isolated environment.
# Note: python3-fedora was dropped between Fedora 41 and 44; the bridge's
#       'import fedora.client' is wrapped in try/except ImportError and only
#       used when FAS authentication is enabled, which we don't use.
# Note: gnupg2 is preinstalled in fedora:44, so it's not in the install list.
RUN dnf install -y --setopt=install_weak_deps=False \
        rpm-head-signing jq && \
    pip3 install --require-hashes --no-build-isolation \
        -r /tmp/requirements/sigul.txt && \
    dnf clean all

# Install crypt module compatibility shim for Python 3.14
COPY build-scripts/crypt_compat.py /usr/lib/python3.14/site-packages/crypt.py

# Copy patches for debugging (if they exist)
COPY patches/ /tmp/patches/

# Copy local sigul source for debugging builds
COPY .build-context/sigul /build-context/sigul/

# Create sigul user and directories with consistent UID 1000 and GID 1000 EARLY
# Handle both RPM-created users (x86_64) and manual creation (ARM64)
RUN if getent passwd sigul >/dev/null; then \
        existing_uid=$(id -u sigul); \
        existing_gid=$(id -g sigul); \
        echo "Existing sigul user has UID $existing_uid, GID $existing_gid, recreating with UID/GID 1000"; \
        userdel sigul 2>/dev/null || true; \
        groupdel sigul 2>/dev/null || true; \
    fi && \
    groupadd -g 1000 sigul && \
    useradd -u 1000 -g 1000 -d /var/lib/sigul -s /bin/bash sigul && \
    mkdir -p /etc/sigul && \
    mkdir -p /etc/pki/sigul/bridge && \
    mkdir -p /var/lib/sigul/bridge && \
    mkdir -p /var/log/sigul/bridge && \
    mkdir -p /run/sigul/bridge && \
    touch /var/log/sigul_bridge.log && \
    touch /var/run/sigul_bridge.pid && \
    chown -R sigul:sigul /etc/sigul /etc/pki/sigul /var/lib/sigul /var/log/sigul /run/sigul && \
    chown sigul:sigul /var/log/sigul_bridge.log /var/run/sigul_bridge.pid && \
    chmod 755 /etc/sigul /etc/pki/sigul /var/lib/sigul /var/log/sigul /run/sigul && \
    chmod 755 /etc/pki/sigul/bridge /var/lib/sigul/bridge /var/log/sigul/bridge /run/sigul/bridge && \
    chmod 644 /var/log/sigul_bridge.log /var/run/sigul_bridge.pid && \
    echo "sigul ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers.d/sigul && \
    chmod 0440 /etc/sudoers.d/sigul

# Install python-nss-ng from its hash lock; this is the last install
# that reads /tmp/requirements, so the copy goes with the script.
COPY build-scripts/install-python-nss.sh /tmp/install-python-nss.sh
RUN chmod +x /tmp/install-python-nss.sh && \
    /tmp/install-python-nss.sh --verify && \
    rm -r /tmp/install-python-nss.sh /tmp/requirements

# Copy and run sigul installation script AS ROOT (installs to system locations)
COPY build-scripts/install-sigul.sh /tmp/install-sigul.sh
RUN chmod +x /tmp/install-sigul.sh && \
    /tmp/install-sigul.sh --verify bridge && \
    rm /tmp/install-sigul.sh && \
    rm -rf /tmp/patches && \
    rm -rf /usr/share/sigul/__pycache__ && \
    chown -R sigul:sigul /usr/share/sigul && \
    chmod -R u+w /usr/share/sigul

# pip has finished its work; remove it and its vendored urllib3 copies
COPY build-scripts/remove-pip.sh /tmp/remove-pip.sh
RUN /tmp/remove-pip.sh && \
    rm /tmp/remove-pip.sh

# Production-aligned initialization

# Copy sigul entrypoint script
COPY scripts/entrypoint-bridge.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Copy certificate initialization script
COPY scripts/cert-init.sh /usr/local/bin/cert-init.sh
RUN chmod +x /usr/local/bin/cert-init.sh

# Copy validation tools (used during one-time setup, not startup)
COPY scripts/validate-nss.sh /usr/local/bin/validate-nss.sh
COPY scripts/lib/health.sh /usr/local/bin/health.sh
RUN chmod +x /usr/local/bin/validate-nss.sh /usr/local/bin/health.sh

# Production-aligned certificate management

# Copy shared PKI files for certificate generation
COPY pki/ /workspace/pki/
# Copy sigul certificate generation script
COPY pki/generate-production-aligned-certs.sh /usr/local/bin/generate-production-aligned-certs.sh
RUN chmod +x /usr/local/bin/generate-production-aligned-certs.sh && \
    chown -R sigul:sigul /workspace/pki/ && \
    if ls /workspace/pki/*.sh >/dev/null 2>&1; then chmod +x /workspace/pki/*.sh; fi

# Set working directory
WORKDIR /var/lib/sigul/bridge

# Compile Python bytecode as sigul user to avoid permission issues
# This happens at build time, before we switch back to root for runtime
USER sigul
RUN python3 -m compileall /usr/share/sigul/ && \
    python3 -c "import sys, os; print('Python version:', sys.version); print('Running as UID:', os.getuid())"

# Switch back to root for runtime
# NOTE: Container starts as root to fix volume permissions
# The entrypoint script will drop privileges to sigul user after fixing permissions
USER root

# Set entrypoint - sigul direct invocation
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

# Health check - verify the bridge is listening on both ports.
# Never probe the bridge by connecting to it: it accepts on 44333 only
# while no server is paired, so bare connects queue in a backlog of
# five until real peers are SYN-dropped, and each one it does accept
# fails the TLS handshake. Read listen state instead.
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=5 \
    CMD ss -tln | grep -q ':44333 ' && ss -tln | grep -q ':44334 ' || exit 1
