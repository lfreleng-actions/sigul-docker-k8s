#
# Sigul server configuration - Kubernetes variant.
# Rendered at pod start by nss-init.sh (envsubst) into an emptyDir;
# never stored in a ConfigMap because it embeds the NSS password.
#
# NOTE: database-path lives UNDER /var/lib/sigul/server, which is both
# the image's WORKDIR and where the PVC is mounted - this fixes the
# compose-stack defect where the SQLite DB landed on the container
# writable layer and was lost on recreation (EVALUATION.md section 2.5).
#
# database-path itself is free: the daemon and the image entrypoint
# both read it from here. gnupg-home is not. The entrypoint prepares
# its own GnuPG directory from a hard-coded SERVER_DATA_DIR before the
# daemon launches (scripts/entrypoint-server.sh, which ships in the
# image the compose stack shares), so gnupg-home must name the same
# path the entrypoint will create. Point it elsewhere and the
# entrypoint still prepares /var/lib/sigul/server/gnupg, fails there if
# that path is not writable, and the daemon never starts - after
# db-init has already reported success.
#
# So move the mount in templates/server-statefulset.yaml, not these
# values.
#
# Variables: NSS_PASSWORD, SERVER_CERT_NICKNAME, BRIDGE_HOSTNAME,
#            BRIDGE_PORT

[server]
bridge-hostname: ${BRIDGE_HOSTNAME}
bridge-port: ${BRIDGE_PORT}
max-file-payload-size: 1073741824
max-memory-payload-size: 1048576
max-rpms-payload-size: 10737418240
server-cert-nickname: ${SERVER_CERT_NICKNAME}
signing-timeout: 60
# Matches the CI stack (scripts/cert-init.sh): authentication still
# requires a CA-signed client cert AND the user's password. Strict
# mode (CN == username) needs per-user client certs - a candidate
# production hardening once per-user issuance exists.
lenient-username-check: ${LENIENT_USERNAME_CHECK}

[database]
database-path: /var/lib/sigul/server/server.sqlite

[gnupg]
gnupg-home: /var/lib/sigul/server/gnupg
gnupg-key-type: RSA
gnupg-key-length: 2048
gnupg-key-usage: sign
passphrase-length: 64

[daemon]
unix-user: sigul
unix-group: sigul

[nss]
nss-dir: /etc/pki/sigul/server
nss-password: ${NSS_PASSWORD}
nss-min-tls: tls1.2
