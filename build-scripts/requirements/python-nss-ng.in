#
# The NSS bindings every image installs from PyPI. Each of
# Dockerfile.{bridge,client,server} installs the lock compiled from
# this file (python-nss-ng.txt) with uv. The lock carries the digest of
# every artefact of the release, so uv can take the wheel built for
# the image's Python and architecture; the install refuses the sdist,
# whose build tooling --require-hashes would not reach.
#
# Compile the lock with:
#   uv pip compile --generate-hashes --universal --python-version 3.14 \
#     --output-file python-nss-ng.txt python-nss-ng.in

python-nss-ng==1.3.2
