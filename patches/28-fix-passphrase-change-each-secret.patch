+def _reprotect_secrets_left_on_old(config, key, old_passphrase,
+                                   new_passphrase):
+    '''Re-protect each secret the edit session left on the old passphrase.
+
+    gpg relays the agent's request for a secret's old passphrase and its
+    request for the new one as the same prompt. Past a key's first secret
+    the agent asks again for whichever passphrase its cache has lost, so
+    the responder can answer a new-passphrase prompt with the old one.
+    That secret then stays on the old passphrase although the session
+    succeeds, and the responder answers the next secret's old-passphrase
+    prompt with the new one, so that secret fails. Re-protect any secret
+    left on the old passphrase through the agent directly, which names
+    each request, then require every secret present to accept the new
+    passphrase. Return True once at least one secret was checked.
+
+    '''
+    old_passphrase = _passphrase_bytes(old_passphrase)
+    new_passphrase = _passphrase_bytes(new_passphrase)
+    if old_passphrase == new_passphrase:
+        return False
+    checked = 0
+    for subkey in key.subkeys:
+        keygrip = getattr(subkey, 'keygrip', None)
+        if (not subkey.secret or not keygrip
+                or not os.path.exists(os.path.join(
+                    config.gnupg_home, 'private-keys-v1.d',
+                    keygrip + '.key'))):
+            continue
+        if _gpg_passphrase_unlocks(config, keygrip, old_passphrase):
+            logging.warning('Secret %s still accepts the old passphrase '
+                            'after the edit session; re-protecting it',
+                            keygrip)
+            _gpg_reprotect_secret(config, keygrip, old_passphrase,
+                                  new_passphrase)
+            if _gpg_passphrase_unlocks(config, keygrip, old_passphrase):
+                logging.error('Secret %s could not be re-protected', keygrip)
+                raise GPGError('The key is still protected by its old '
+                               'passphrase')
+        # A probe that fails to run also reads as "not unlocked", so the
+        # old-passphrase probe alone cannot clear a secret
+        if not _gpg_passphrase_unlocks(config, keygrip, new_passphrase):
+            logging.error('Secret %s does not accept the new passphrase',
+                          keygrip)
+            raise GPGError('The new passphrase does not unlock the key')
+        checked += 1
+    return checked > 0
+
+
+def _gpg_reprotect_secret(config, keygrip, old_passphrase, new_passphrase):
+    '''Re-protect the secret with keygrip through the server's agent.'''
+    tmp_dir = tempfile.mkdtemp(prefix='sigul-passwd-')
+    try:
+        files = []
+        for name, passphrase in (('old', old_passphrase),
+                                 ('new', new_passphrase)):
+            path = os.path.join(tmp_dir, name)
+            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+            with os.fdopen(fd, 'wb') as f:
+                f.write(passphrase)
+            files.append(path)
+        reply = subprocess.run(
+            [os.path.join(os.path.dirname(settings.gnupg_bin),
+                          'gpg-connect-agent'),
+             '--homedir', config.gnupg_home,
+             '/definqfile PASSPHRASE ' + files[0],
+             '/definqfile NEW_PASSPHRASE ' + files[1],
+             'OPTION pinentry-mode=loopback',
+             'PASSWD ' + keygrip, '/bye'],
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        errors = [line for line in
+                  reply.stdout.decode('utf-8', 'replace').splitlines()
+                  if line.startswith('ERR')]
+        if reply.returncode != 0 or errors:
+            logging.error('Re-protecting secret %s failed: gpg-connect-agent '
+                          'exited %d, errors %s, stderr %r', keygrip,
+                          reply.returncode, errors,
+                          reply.stderr.decode('utf-8', 'replace').strip())
+    finally:
+        shutil.rmtree(tmp_dir, ignore_errors=True)
+
+
