+def _log_secret_listing(config, key, fingerprint):
+    '''Log what a refused key's listing says about its secrets.
+
+    The check reads a listing taken before the edit session. Log it beside
+    a listing taken now and the key files the agent holds, so that a
+    listing which disagrees with the home can be told from a key that was
+    rightly refused. A keygrip names a secret; it is not secret itself.
+
+    '''
+    def describe(listed):
+        return '; '.join(
+            '%s secret=%s sign=%s file=%s' % (
+                getattr(subkey, 'keygrip', None), bool(subkey.secret),
+                bool(subkey.can_sign),
+                os.path.exists(os.path.join(
+                    config.gnupg_home, 'private-keys-v1.d',
+                    '%s.key' % getattr(subkey, 'keygrip', None))))
+            for subkey in listed.subkeys)
+
+    logging.error('Refused a key listed before the edit as: %s',
+                  describe(key))
+    try:
+        fresh = _gpg_open(config).get_key(fingerprint, True)
+    except ourgpg.GPGMEError as e:
+        logging.error('Listing the key again failed: %s', e)
+        return
+    logging.error('The same key listed now: %s', describe(fresh))
+
