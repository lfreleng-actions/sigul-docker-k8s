+def _is_bad_passphrase(line):
+    '''Return True if an agent ERR line reports a wrong passphrase.'''
+    fields = line.split()
+    # The low 16 bits are the error code; 11 is GPG_ERR_BAD_PASSPHRASE
+    return (len(fields) > 1 and fields[1].isdigit()
+            and int(fields[1]) & 0xFFFF == 11)
