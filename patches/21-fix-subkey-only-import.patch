+                                  new_passphrase, responder.failure)
+
+
+def _check_subkey_only_rewrap(config, key, old_passphrase, new_passphrase,
+                              failure):
+    '''Accept a failed passphrase change only for a subkey-only key.
+
+    GnuPG cannot re-protect a primary key whose secret is a stub, so the
+    session ends in FAILURE although every secret present was
+    re-protected. Accept it only when the primary secret is absent and a
+    signing subkey's secret is present, and only once every secret present
+    accepts the new passphrase and refuses the old one.
+
+    '''
+    secrets = [subkey for subkey in key.subkeys[1:] if subkey.secret]
+    if key.subkeys[0].secret or not any(subkey.can_sign for subkey in secrets):
+        logging.error('GPG passphrase change failed: %s', failure)
+        raise GPGError('Changing the key passphrase failed')
+    new_passphrase = _passphrase_bytes(new_passphrase)
+    old_passphrase = _passphrase_bytes(old_passphrase)
+    for subkey in secrets:
+        if not _gpg_passphrase_unlocks(config, subkey.keygrip,
+                                       new_passphrase):
+            raise GPGError('The new passphrase does not unlock the key')
+        if (old_passphrase != new_passphrase
+                and _gpg_passphrase_unlocks(config, subkey.keygrip,
+                                            old_passphrase)):
+            raise GPGError('The key is still protected by its old passphrase')
+    logging.info('Re-protected a key whose primary secret is not present')
+
+
+def _passphrase_bytes(passphrase):
+    if isinstance(passphrase, str):
+        return passphrase.encode('utf-8')
+    return passphrase
+
+
+def _gpg_passphrase_unlocks(config, keygrip, passphrase):
+    '''Return True if passphrase unlocks the secret key with keygrip.
+
+    The server's own agent may still hold the key unlocked from the edit
+    session, and would accept whatever passphrase is offered. Test the
+    secret as stored instead: copy it into a throwaway home and ask a fresh
+    agent there to verify the passphrase, which changes nothing.
+
+    '''
+    home = tempfile.mkdtemp(prefix='sigul-check-')
+    bindir = os.path.dirname(settings.gnupg_bin)
+    try:
+        os.mkdir(os.path.join(home, 'private-keys-v1.d'), 0o700)
+        shutil.copy(os.path.join(config.gnupg_home, 'private-keys-v1.d',
+                                 keygrip + '.key'),
+                    os.path.join(home, 'private-keys-v1.d'))
+        generate_gpg_config(home)
+        passphrase_file = os.path.join(home, 'passphrase')
+        fd = os.open(passphrase_file, os.O_WRONLY | os.O_CREAT | os.O_EXCL,
+                     0o600)
+        with os.fdopen(fd, 'wb') as f:
+            f.write(passphrase)
+        reply = subprocess.run(
+            [os.path.join(bindir, 'gpg-connect-agent'), '--homedir', home,
+             '/definqfile PASSPHRASE ' + passphrase_file,
+             'OPTION pinentry-mode=loopback',
+             'PASSWD --verify ' + keygrip, '/bye'],
+            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout
+        lines = reply.decode('utf-8', 'replace').splitlines()
+        return (len(lines) >= 2 and lines[-1] == 'OK'
+                and not any(line.startswith('ERR') for line in lines))
+    finally:
+        subprocess.call([os.path.join(bindir, 'gpgconf'), '--homedir', home,
+                         '--kill', 'all'],
+                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        shutil.rmtree(home, ignore_errors=True)


