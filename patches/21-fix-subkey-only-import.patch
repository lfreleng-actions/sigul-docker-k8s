#
# Import keys whose primary secret is a stub. An import re-protects the
# key's secrets under the server's passphrase through 'gpg --edit-key'
# 'passwd'; GnuPG cannot re-protect a primary secret it does not have, so
# for a 'gpg --export-secret-subkeys' export the session ends in FAILURE
# although the subkey was re-protected. That status reached a callback
# with no case for it, which raised NotImplementedError and took the
# server down; a wrong import passphrase ends the same way, for any key.
# FAILURE is now recorded, and accepted only for a key whose primary
# secret is absent once every secret present accepts the new passphrase
# and refuses the old one. Deleting a key also removes the subkey secrets
# gpgme leaves behind, so a failed import can be retried (#96). See
# patches/README.md.
#
--- a/src/server_common.py
+++ b/src/server_common.py
@@ -435,10 +435,36 @@ def gpg_public_key(config, fingerprint):


 def gpg_delete_key(config, fingerprint):
-    '''Delete the specified key.'''
+    '''Delete the specified key, including every secret it had.'''
     ctx = _gpg_open(config)
     key = ctx.get_key(fingerprint, True)
+    keygrips = [subkey.keygrip for subkey in key.subkeys
+                if subkey.secret and getattr(subkey, 'keygrip', None)]
     ctx.delete(key, True)
+    _gpg_delete_secrets(config, keygrips)
+
+
+def _gpg_delete_secrets(config, keygrips):
+    '''Remove secret keys that deleting their key left behind.
+
+    For a key whose primary secret is a stub (gpg --export-secret-subkeys),
+    gpgme deletes the public key but leaves the subkey secrets, and a later
+    import of the same key is then refused. Remove each through the agent,
+    as gpg --delete-secret-keys would.
+
+    '''
+    agent = os.path.join(os.path.dirname(settings.gnupg_bin),
+                         'gpg-connect-agent')
+    for keygrip in keygrips:
+        path = os.path.join(config.gnupg_home, 'private-keys-v1.d',
+                            keygrip + '.key')
+        if not os.path.exists(path):
+            continue
+        subprocess.call([agent, '--homedir', config.gnupg_home,
+                         'DELETE_KEY --force ' + keygrip, '/bye'],
+                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        if os.path.exists(path):
+            raise GPGError('Could not delete secret key %s' % keygrip)


