 _LISTEN_BACKLOG = 128

+# Longest the bridge waits, while relaying a request, for a single byte
+# to move in either direction before abandoning the request. A client
+# suspended mid-upload, a CI runner paused by its scheduler, or a peer
+# behind a NAT that has dropped the flow all look exactly like a slow
+# peer, and the bridge serves one client at a time. Two minutes is far
+# beyond any silence a real request produces: even the server's largest
+# signing operations stream data or finish in seconds.
+_REQUEST_IDLE_SECONDS = 120

+
