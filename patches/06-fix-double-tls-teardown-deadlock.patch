+# Teardown bounds.
+#
+# An idle forwarding loop legitimately blocks for hours: a server child
+# sits in poll() waiting for a request that may not arrive until the
+# next CI job. So the loop below only becomes impatient once the LOCAL
+# side has gone away - at that point the only thing left to wait for is
+# the peer closing its half, and a peer that never does must not pin
+# the process forever.
+#
+# Without this, a peer left in CLOSE-WAIT deadlocks three processes:
+# the forwarding child blocks in poll(), the connection owner blocks in
+# waitpid() inside outer_close(), and the daemon's main loop blocks in
+# waitpid() on that. The service then answers nothing further while
+# still looking alive, because the process is present and the socket
+# is merely half-closed.
+_SHUTDOWN_LINGER_SECONDS = 30
+_SHUTDOWN_POLL_TICK_SECONDS = 1
+
+# How long outer_close() waits for the forwarding child to exit on its
+# own before killing it. The child holds no state worth preserving: it
+# forwards bytes between sockets that are, by this point, closed.
+_CHILD_EXIT_TIMEOUT_SECONDS = 10
+
