+        # The child is wedged - historically in poll(), waiting for a
+        # peer that never closed its half of the connection. Blocking
+        # here would take the whole daemon down with it, because the
+        # caller's own parent is in turn waiting on the caller.
+        logging.warning('Forwarding child %d did not exit within %d s; '
+                        'killing it', self.__child_pid,
+                        _CHILD_EXIT_TIMEOUT_SECONDS)
+        try:
+            os.kill(self.__child_pid, signal.SIGKILL)
+        except OSError:
+            # Raced with the child exiting; the waitpid below still reaps it.
+            pass
