+# Teardown bounds for the DoubleTLSClient forwarding child.
+#
+# An idle forwarding loop legitimately blocks for hours: a server child
+# sits in poll() waiting for a request that may not arrive until the
+# next CI job. So the child only becomes impatient once the LOCAL side
+# has gone away - at that point the only thing left to wait for is the
+# peer closing its half, and a peer that never does must not pin the
+# process forever.
+#
+# Without this, a peer left in CLOSE-WAIT deadlocks three processes:
+# the forwarding child blocks in poll(), the connection owner blocks in
+# waitpid() inside outer_close(), and the daemon's main loop blocks in
+# waitpid() on that. The service then answers nothing further while
+# still looking alive, because the process is present and the socket
+# is merely half-closed.
+#
+# The linger is short because there is nothing of value to wait for: a
+# live peer sends its FIN within milliseconds of receiving ours, and
+# anything that arrives after the local side has closed is dropped.
+# The wait exists so a healthy close stays clean, not to recover data.
+_SHUTDOWN_LINGER_SECONDS = 5
+_SHUTDOWN_POLL_TICK_SECONDS = 1
+
+# How long outer_close() waits for the forwarding child to exit on its
+# own before killing it. This must exceed the linger plus one poll
+# tick: the child's own bound above is the graceful path - it closes
+# its sockets and exits normally - and the kill here is the fallback
+# for a child stuck somewhere other than the poll loop. The child holds
+# no state worth preserving either way: it forwards bytes between
+# sockets that are, by this point, closed.
+_CHILD_EXIT_TIMEOUT_SECONDS = 10
+
 _chunk_inner_mask = 1 << 31


