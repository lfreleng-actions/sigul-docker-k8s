#
# Close the bridge's server socket on every exit path, and notice a
# server that dies while the bridge waits for a client. See
# patches/README.md for the full rationale and production evidence.
#
--- a/src/bridge.py
+++ b/src/bridge.py
@@ -1423,13 +1423,49 @@
         '''Drop per-connection state.'''
         if self.__handler is not None:
             self.__handler.close()
+
+
+def _wait_for_client_or_server_loss(server_sock, client_listen_sock):
+    '''Block until a client connects or the paired server goes away.
+
+    Return True when a client connection is pending on client_listen_sock,
+    False when server_sock reported readiness first - which, for a
+    server that has completed its outer handshake and is waiting for a
+    client, can only mean it has closed or failed, because it sends
+    nothing until the client arrives.
+
+    A bare client_listen_sock.accept() cannot do this: it blocks with no
+    knowledge of server_sock, so a server that dies during the wait is
+    only discovered when a client finally connects and is handed the
+    corpse. It also means the server's FIN sits unread, so the bridge
+    never closes its half and the server's teardown - if unbounded -
+    waits forever on a FIN that never comes.
+
+    '''
+    # Readability is the only interest to request; NSPR reports errors
+    # and hangups in the output flags regardless, and any event on the
+    # server socket means the server is gone.
+    descs = [
+        (client_listen_sock, nss.io.PR_POLL_READ),
+        (server_sock, nss.io.PR_POLL_READ),
+    ]
+    while True:
+        res = nss.io.Socket.poll(descs, nss.io.PR_INTERVAL_NO_TIMEOUT)
+        client_ready, server_event = res[0], res[1]
+        if server_event:
+            _adbg('Server socket reported %r while waiting for a client',
+                  server_event)
+            return False
+        if client_ready & nss.io.PR_POLL_READ:
+            return True


 def bridge_one_request(config, server_listen_sock, client_listen_sock):
     '''Forward one request and reply.'''

+    server_sock = None
