+        logging.debug('Waiting for the client to connect')
+        if not _wait_for_client_or_server_loss(server_sock,
+                                               client_listen_sock):
+            # The server left before any client arrived. Drop it and go
+            # back to waiting for a fresh server rather than handing the
+            # next client a dead connection.
+            logging.info('Server connection lost while waiting for a client; '
+                         'discarding it')
+            return
+        (client_sock, client_addr) = client_listen_sock.accept()
+        _adbg('Client-side TCP accept from %r', client_addr)
+        BridgeConnection.handle_connection(config, client_sock, server_sock)
     # Python 3.10 made this a deprecated alias of TimeoutError so it's only a matter of
     # time before they remove this alias and break everyone. Replace this with TimeoutError
     # when upgrading to support Python 3.10+
@@ -1489,6 +1526,20 @@
             logging.info('NSPR I/O error: %s', str(e), exc_info=True)
     except BridgeError as e:
         logging.warning(str(e))
+    finally:
+        # Close on EVERY exit, including a failed server handshake or a
+        # missing server certificate. Previously only the client-wait
+        # block was covered, so a server that failed its handshake was
+        # accepted, rejected and then never closed - leaking one socket
+        # per attempt, each left in CLOSE-WAIT with the peer's final
+        # bytes unread. Unread bytes and an unsent FIN are also what
+        # keep the peer's own teardown waiting.
+        for sock in (client_sock, server_sock):
+            if sock is not None:
+                try:
+                    sock.close()
+                except Exception as e:
+                    _adbg('Ignoring error closing socket: %r', e)
