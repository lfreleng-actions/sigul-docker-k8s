 # signing operations stream data or finish in seconds.
 _REQUEST_IDLE_SECONDS = 120

+# How often the bridge's liveness heartbeat is published, and the
+# longest any wait that would otherwise block indefinitely may last
+# before the main loop comes round again. The liveness probe reads the
+# heartbeat's age, so both must stay well inside its tolerance.
+_HEARTBEAT_INTERVAL_SECONDS = 5
+_IDLE_WAIT_SLICE_SECONDS = 10

+# The longest the request handlers' own phases - payload forwarding and
+# the post-request phase - may run without reporting. They are where
+# RPM signing talks to Koji and to the worker threads, and neither
+# reports progress, so they get a bound of their own: long enough for a
+# large RPM batch against a slow Koji, finite so that a Koji call that
+# never returns is still caught. Deployments that do not use Koji never
+# enter them for long.
+_HANDLER_PHASE_SECONDS = 30 * 60
+
+
+class Heartbeat(object):
+    '''Proof, for the liveness probe, that the bridge is making progress.
+
+    Every health check the bridge had tested state a wedged daemon
+    keeps: a live process and a listening socket. So a frozen or stuck
+    bridge stayed Ready indefinitely while every request hung.
+
+    The main loop reports progress on every wakeup of every wait,
+    naming the longest that wait may legitimately block. A publisher
+    thread rewrites the heartbeat file every few seconds, for as long
+    as the main loop is inside its own bound. It stops the moment the
+    main loop overruns - stuck in a syscall, deadlocked, looping
+    without waiting - and stops too when the whole process is frozen,
+    since the thread is part of it. Either way the file goes stale and
+    liveness restarts the daemon.
+
+    The file is rewritten in place rather than replaced, and the probe
+    reads its mtime, so it never has to parse anything a half-written
+    update could leave behind.
+
+    '''
+
+    def __init__(self, path):
+        self.__path = path
+        self.__lock = threading.Lock()
+        self.__overdue_at = time.monotonic() + _IDLE_WAIT_SLICE_SECONDS
+
+    def progress(self, bound=None):
+        '''The main loop is alive, and may block for up to bound seconds.
+
+        None means the caller could not say; the idle slice applies.
+
+        '''
+        if bound is None:
+            bound = _IDLE_WAIT_SLICE_SECONDS
+        with self.__lock:
+            # Slack on top of the bound: a wait that ends exactly on time
+            # still has a little work to do before it reports again.
+            self.__overdue_at = time.monotonic() + bound + \
+                _HEARTBEAT_INTERVAL_SECONDS
+
+    def start(self):
+        self.__publish()
+        thread = threading.Thread(target=self.__run, name='heartbeat')
+        thread.daemon = True
+        thread.start()
+
+    def __run(self):
+        warned = None
+        while True:
+            time.sleep(_HEARTBEAT_INTERVAL_SECONDS)
+            with self.__lock:
+                on_time = time.monotonic() < self.__overdue_at
+            if on_time:
+                self.__publish()
+                warned = None
+            elif warned is None or time.monotonic() - warned >= 60:
+                # Said once, then once a minute: a line per missed beat
+                # would bury whatever led to it.
+                logging.warning('Main loop overdue; heartbeat withheld so '
+                                'that liveness restarts the bridge')
+                warned = time.monotonic()
+
+    def __publish(self):
+        try:
+            with open(self.__path, 'w') as f:
+                f.write('{0:.0f}\n'.format(time.time()))
+        except (IOError, OSError) as e:
+            # Better a stale heartbeat, and a restart, than a crashed
+            # publisher and an unexplained one.
+            logging.warning('Cannot write heartbeat %s: %s', self.__path, e)
+
+
+_heartbeat = None
+
+
+def _progress(bound=None):
+    if _heartbeat is not None:
+        _heartbeat.progress(bound)
+
