#
# Keep serving after a request child dies. The parent treated any request
# child that died abnormally - an unhandled exception, an unknown exit
# status, a signal - as fatal, and left its main loop, so one failing
# request stopped the server for every client until it was restarted.
# Such a death now fails only that request; the parent logs it and forks
# the next child. If MAX_CHILD_DEATHS children die within
# CHILD_DEATH_WINDOW_SECONDS the request path itself is broken, and the
# server exits as before so its supervisor restarts it (#97). See
# patches/README.md.
#
--- a/src/server.py
+++ b/src/server.py
@@ -116,6 +116,11 @@ else:
 MAX_FAST_RECONNECTIONS = 5
 FAST_RECONNECTION_SECONDS = 5
 SLOW_RECONNECTION_SECONDS = 60
+# A request child that dies abnormally fails only its own request. Children
+# dying faster than this mean the request path itself is broken, so the
+# server exits for its supervisor to restart it, as it used to on the first.
+MAX_CHILD_DEATHS = 5
+CHILD_DEATH_WINDOW_SECONDS = 60
 # How long a request child may wait for a request, and then how long it
 # may spend on one, before it is killed. The first bounds an idle child,
 # which is then replaced; the second is timed from the request's arrival.
@@ -2880,6 +2885,19 @@ _CHILD_TIMEOUT = 3              # Request handler timed out and was killed
 # Undefined values are treated as _CHILD_BUG:


+def _child_died(deaths, now):
+    '''Record a request child's abnormal death at now.
+
+    Return the deaths still inside CHILD_DEATH_WINDOW_SECONDS, this one
+    included, and whether there are enough of them that the server
+    should exit rather than serve on.
+
+    '''
+    deaths = [death for death in deaths
+              if now - death < CHILD_DEATH_WINDOW_SECONDS] + [now]
+    return deaths, len(deaths) >= MAX_CHILD_DEATHS
+
+
 def request_handling_child(config):
     '''Handle a single request, runinng in a child process.

@@ -3207,6 +3225,7 @@ def main():
     try:
         try:
             fast_reconnections_done = 0
+            child_deaths = []
             while True:
                 child_pid = os.fork()
                 if child_pid == 0:
@@ -3238,7 +3257,13 @@ def main():
                     logging.warning("Child timed out handling request and was killed")
                 else:  # _CHILD_BUG, unknown status code or WIFSIGNALED
                     logging.error('Child died with status %d', status)
-                    break
+                    child_deaths, crash_loop = _child_died(child_deaths,
+                                                           time.monotonic())
+                    if crash_loop:
+                        logging.error('%d request children died within %d '
+                                      'seconds; exiting', len(child_deaths),
+                                      CHILD_DEATH_WINDOW_SECONDS)
+                        break
         except (KeyboardInterrupt, SystemExit):
             pass  # Silence is golden
     finally:
