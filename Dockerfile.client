# Unified Dockerfile for sigul client using the new cert-init approach
# Base image pinned by digest for supply-chain integrity (Scorecard
# Pinned-Dependencies). Dependabot maintains the digest via the docker
# ecosystem entry in .github/dependabot.yml.
FROM fedora:44@sha256:43b29f65a41eb9c35e1cd5323e3bdf3b655c2357a9f4f1ff2f9c2798e5045d80

LABEL maintainer="releng@linuxfoundation.org"
# Standard OCI metadata labels (image.title, image.description,
# image.source, image.url, image.revision, image.created,
# image.licenses, image.version) are generated by
# docker/metadata-action in the CI workflow at build time. See
# .github/workflows/{build-test,release}.yaml for the values used.

# Update package manager
RUN dnf update -y && \
    dnf clean all

# Install base dependencies for all architectures
# Note: nss-devel and nspr-devel removed - python-nss-ng installed from PyPI (pre-built)
# Note: gnupg2 is preinstalled in fedora:44, so it's not in the install list.
RUN dnf install -y --setopt=install_weak_deps=False --allowerasing \
        git which curl tar gzip xz patch \
        python3-devel python3-pip python3-koji python3-requests \
        python3-rpm python3-setuptools python3-cryptography python3-pexpect python3-gpg \
        koji-utils expect \
        rpm-build \
        make gcc autoconf automake libtool \
        procps-ng util-linux bind-utils \
        strace lsof \
        vim-minimal less findutils grep \
        curl wget rsync nmap-ncat \
        hostname iproute net-tools \
        sqlite nss-tools jq && \
    dnf clean all

# Patch CVEs that fedora:44 ships unpatched in its Python packages.
# pip 26.0.1 is affected by GHSA-58qw-9mgm-455v and GHSA-jp4c-xjxw-mgf9
# (fixed in 26.1) plus CVE-2026-8643, an entry-point path traversal
# fixed in 26.1.2. setuptools 80.10.2 is affected by CVE-2026-59890 /
# GHSA-h35f-9h28-mq5c, a MANIFEST.in exclusion bypass fixed in 83.0.0.
# Upgrading via pip is required because Fedora 44 has not (yet) pushed
# updated python3-pip / python3-setuptools packages, so 'dnf upgrade'
# alone leaves the flagged versions in place. --break-system-packages
# overrides Fedora's EXTERNALLY-MANAGED marker (PEP 668) so the
# upgraded versions land under /usr/local, ahead of the dnf tree.
#
# setuptools >= 82 no longer bundles pkg_resources. The dnf-managed
# copy under /usr/lib stays on sys.path and still satisfies
# 'import pkg_resources' for any consumer that needs it.
#
# The loop then drops the superseded dist-info from the dnf tree so the
# Grype SBOM scan reports only the upgraded version; leaving both would
# make Grype flag the old metadata as a second, vulnerable install. It
# is deliberately guarded on a /usr/local dist-info existing, because
# --upgrade installs nothing whenever the dnf-provided version is
# already the newest on PyPI. In that case there is no replacement to
# point at, so the dnf metadata must be retained, or the package would
# disappear from the SBOM altogether.
#
# idna and cryptography previously needed the same treatment for
# GHSA-65pc-fj4g-8rjx and GHSA-537c-gmf6-5ccf. Fedora 44 ships idna
# 3.18, already fixed, so that pin stays removed. cryptography needs
# the treatment again: 49.0.0 is affected by CVE-2026-69247 /
# GHSA-g6cj-pr64-35w5 (PKCS#7 EnvelopedData decryption exposes a
# Bleichenbacher oracle; affects >=44.0.0 <50.0.0), and Fedora 44 has
# not (yet) shipped an updated python3-cryptography. The pin is a
# floor with no upper cap: a '<' cap previously caused an older
# /usr/local install to shadow a newer, fixed dnf-provided version.
#
# The lib* globs matter: pure-Python packages (pip, setuptools) live
# under lib/, but packages with compiled extensions (cryptography)
# land in Fedora's platform-specific lib64/ tree - in both the dnf
# and /usr/local install roots. Checking only lib/ leaves the stale
# dnf dist-info behind and Grype keeps flagging the old version.
RUN python3 -m pip install --upgrade --break-system-packages \
        'pip>=26.1.2' 'setuptools>=83.0.0' 'cryptography>=50.0.0' && \
    for pkg in pip setuptools cryptography; do \
        if ls -d /usr/local/lib*/python3*/site-packages/"${pkg}"-*.dist-info \
            >/dev/null 2>&1; then \
            rm -rf /usr/lib*/python3*/site-packages/"${pkg}"-*.dist-info; \
        fi; \
    done

# Copy patches for debugging (if they exist)
COPY patches/ /tmp/patches/

# Copy local sigul source for debugging builds
COPY .build-context/sigul /build-context/sigul/

# Install python-nss-ng v1.2.2 from PyPI (Fedora 44 has Python 3.14 which is compatible)
ENV INSTALL_SOURCE=pypi
ENV PYTHON_NSS_NG_VERSION=1.2.2
COPY build-scripts/install-python-nss.sh /tmp/install-python-nss.sh
RUN chmod +x /tmp/install-python-nss.sh && \
    /tmp/install-python-nss.sh --verify && \
    rm /tmp/install-python-nss.sh

# Copy and run sigul installation script
COPY build-scripts/install-sigul.sh /tmp/install-sigul.sh
RUN chmod +x /tmp/install-sigul.sh && \
    /tmp/install-sigul.sh --verify client && \
    rm /tmp/install-sigul.sh && \
    rm -rf /tmp/patches

# Create symlinks for NSS unsupported tools to make them accessible for testing
RUN ln -sf /usr/lib64/nss/unsupported-tools/tstclnt /usr/local/bin/tstclnt && \
    ln -sf /usr/lib64/nss/unsupported-tools/selfserv /usr/local/bin/selfserv && \
    ln -sf /usr/lib64/nss/unsupported-tools/strsclnt /usr/local/bin/strsclnt

# NSS-only initialization

# Copy NSS-only initialization script and validation tools

COPY scripts/validate-nss.sh /usr/local/bin/validate-nss.sh
COPY scripts/lib/health.sh /usr/local/bin/health.sh
COPY scripts/sigul-config-nss-only.template /usr/local/bin/sigul-config-nss-only.template
COPY scripts/init-client-certs.sh /usr/local/bin/init-client-certs.sh
RUN chmod +x /usr/local/bin/validate-nss.sh /usr/local/bin/health.sh /usr/local/bin/init-client-certs.sh

# NSS-only certificate management

# Copy shared PKI files for certificate generation (permissions set later after user creation)
COPY pki/ /workspace/pki/

# Copy signing entrypoint script for backward compatibility
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Create sigul user and directories with consistent UID 1000 and GID 1000
# Handle both RPM-created users (x86_64) and manual creation (ARM64)
RUN if getent passwd sigul >/dev/null; then \
        # User exists, remove it and recreate with consistent UID/GID
        existing_uid=$(id -u sigul); \
        existing_gid=$(id -g sigul); \
        echo "Existing sigul user has UID $existing_uid, GID $existing_gid, recreating with UID/GID 1000"; \
        userdel sigul 2>/dev/null || true; \
        groupdel sigul 2>/dev/null || true; \
    fi && \
    # Create group first with GID 1000
    groupadd -g 1000 sigul && \
    # Create user with UID 1000 and GID 1000
    useradd -u 1000 -g 1000 -d /var/sigul -s /bin/bash sigul && \
    # Create unified sigul directory structure under /var/sigul
    mkdir -p /var/sigul && \
    chown sigul:sigul /var/sigul && \
    chmod 755 /var/sigul && \
    # Create /var/lib/sigul directory for NSS databases and GPG
    mkdir -p /var/lib/sigul && \
    chown sigul:sigul /var/lib/sigul && \
    chmod 755 /var/lib/sigul && \
    # Pre-create log file with correct ownership for sigul user
    touch /var/log/sigul_client.log && \
    chown sigul:sigul /var/log/sigul_client.log && \
    chmod 644 /var/log/sigul_client.log && \
    # Set proper permissions on PKI files after user creation
    # Only chmod files that exist (some are generated at runtime)
    if ls /workspace/pki/*.crt >/dev/null 2>&1; then chmod 644 /workspace/pki/*.crt; fi && \
    if ls /workspace/pki/*.conf >/dev/null 2>&1; then chmod 644 /workspace/pki/*.conf; fi && \
    if ls /workspace/pki/*.conf.template >/dev/null 2>&1; then chmod 644 /workspace/pki/*.conf.template; fi && \
    if ls /workspace/pki/*-key.pem >/dev/null 2>&1; then chmod 644 /workspace/pki/*-key.pem; fi && \
    if ls /workspace/pki/*.sh >/dev/null 2>&1; then chmod +x /workspace/pki/*.sh; fi && \
    chown -R sigul:sigul /workspace/pki/

# Copy the wrapper script that dispatches signing, explicit commands,
# or an interactive shell (client init is delegated to
# init-client-certs.sh)
COPY scripts/client-wrapper.sh /usr/local/bin/client-wrapper.sh
RUN chmod +x /usr/local/bin/client-wrapper.sh

# Set working directory to unified structure
WORKDIR /var/sigul

# Switch to sigul user (same as server and bridge)
USER sigul

# Use the wrapper script as the default command
CMD ["/usr/local/bin/client-wrapper.sh"]

# Health check - NSS certificate validation (FHS-compliant path)
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD certutil -d sql:/etc/pki/sigul/client -L -n sigul-ca >/dev/null 2>&1 && \
        certutil -d sql:/etc/pki/sigul/client -L -n sigul-client-cert >/dev/null 2>&1 || exit 1
